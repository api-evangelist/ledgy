    "name": "Ledgy GraphQL API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "HTTP modeling of the Ledgy equity-management GraphQL API. Ledgy exposes a single native GraphQL endpoint at https://app.ledgy.com/graphql; all operations (auth, companyCaptable, companyTransactions, portfolioCaptable, portfolioPerformance, portfolioTransactions) are issued as HTTP POST requests carrying a GraphQL document in the JSON body. This OpenAPI document models that single transport endpoint - it is not a REST decomposition of the schema. See graphql/ledgy-schema.graphql and graphql/ledgy-graphql.md for the GraphQL surface.\n\nContact Support:\n Name: Ledgy Support",
      "type": "text/plain"
    }
  }
